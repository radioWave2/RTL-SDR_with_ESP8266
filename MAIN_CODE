<script>
const BINS=128, FS=20000, WFH=220;
let frame=0, hold=false, pk=new Array(BINS).fill(0);
let CM=[], CF=[];

// Kanvaslar
const sc=document.getElementById('sc'), sX=sc.getContext('2d');
const ax=document.getElementById('ax'), aX=ax.getContext('2d');
const wf=document.getElementById('wf'), wX=wf.getContext('2d');
let wfImg=null;

function resize(){
  const W=sc.parentElement.clientWidth||800;
  sc.width=W; sc.height=220;
  ax.width=W; ax.height=18;
  wf.width=W; wf.height=WFH; wf.style.height=WFH+'px';
  wfImg=wX.createImageData(W,WFH);
  for(let i=3;i<wfImg.data.length;i+=4) wfImg.data[i]=255;
}

// --- Palet ---
function getClr(v,p){
  v=Math.max(0,Math.min(1,v));
  if(p==='heat') return lerp(v,[[0,[0,0,0]],[.3,[100,0,0]],[.6,[255,60,0]],[.85,[255,210,0]],[1,[255,255,200]]]);
  if(p==='plasma') return lerp(v,[[0,[13,8,135]],[.25,[84,2,163]],[.5,[202,71,60]],[.75,[253,179,74]],[1,[240,249,33]]]);
  if(p==='grey'){const c=v*255|0;return[c,c,c];}
  return lerp(v,[[0,[0,0,0]],[.1,[0,0,100]],[.22,[0,0,220]],[.38,[0,180,255]],[.52,[0,255,160]],
                  [.65,[100,255,0]],[.78,[255,255,0]],[.88,[255,80,0]],[.96,[255,0,0]],[1,[255,255,255]]]);
}
function lerp(v,s){
  for(let i=1;i<s.length;i++){
    if(v<=s[i][0]){
      const t=(v-s[i-1][0])/(s[i][0]-s[i-1][0]);
      return s[i-1][1].map((c,k)=>Math.round(c+t*(s[i][1][k]-c)));
    }
  }
  return s[s.length-1][1];
}

// --- Waterfall ---
function wfRow(m){
  if(!wfImg) return;
  const W=wf.width,H=WFH;
  const spd=+document.getElementById('spd').value;
  const lo=+document.getElementById('lo').value;
  const hi=+document.getElementById('hi').value;
  const pal=document.getElementById('pal').value;
  wfImg.data.copyWithin(0,W*4*spd);
  const bw=Math.floor(W/BINS);
  for(let s=0;s<spd;s++){
    const rs=(H-spd+s)*W*4;
    for(let b=0;b<BINS;b++){
      const n=Math.max(0,Math.min(1,(m[b]-lo)/(hi-lo)));
      const [r,g,bl]=getClr(n,pal);
      for(let px=0;px<bw;px++){
        const idx=rs+(b*bw+px)*4;
        wfImg.data[idx]=r;wfImg.data[idx+1]=g;wfImg.data[idx+2]=bl;wfImg.data[idx+3]=255;
      }
    }
  }
  wX.putImageData(wfImg,0,0);
}

// --- Spektrum ---
function drawSpec(m,f){
  const W=sc.width,H=sc.height;
  const lo=+document.getElementById('lo').value;
  const hi=+document.getElementById('hi').value;
  sX.fillStyle='#040810';sX.fillRect(0,0,W,H);

  // Izgara
  sX.strokeStyle='#0c1c2c';sX.lineWidth=1;
  for(let i=0;i<=8;i++){const y=H*i/8;sX.beginPath();sX.moveTo(0,y);sX.lineTo(W,y);sX.stroke();}
  for(let i=0;i<BINS;i+=16){const x=W*i/BINS;sX.beginPath();sX.moveTo(x,0);sX.lineTo(x,H);sX.stroke();}

  // Etiketler
  sX.fillStyle='#1a3a55';sX.font='9px Courier New';sX.textAlign='left';
  for(let i=0;i<=4;i++) sX.fillText(Math.round(hi-i*(hi-lo)/4),2,H*i/4+10);

  // Peak hold
  if(hold){
    sX.beginPath();sX.strokeStyle='rgba(255,220,50,.55)';sX.lineWidth=1;
    pk.forEach((v,i)=>{
      const x=W*i/BINS,n=Math.max(0,Math.min(1,(v-lo)/(hi-lo)));
      i?sX.lineTo(x,H-n*H):sX.moveTo(x,H-n*H);
    });
    sX.stroke();
  }

  // Dolgu
  const g=sX.createLinearGradient(0,0,0,H);
  g.addColorStop(0,'rgba(20,200,255,.95)');
  g.addColorStop(.45,'rgba(0,120,255,.55)');
  g.addColorStop(1,'rgba(0,40,100,.08)');
  sX.beginPath();sX.moveTo(0,H);
  m.forEach((v,i)=>{
    const x=W*i/BINS,n=Math.max(0,Math.min(1,(v-lo)/(hi-lo)));
    sX.lineTo(x,H-n*H);
  });
  sX.lineTo(W,H);sX.closePath();sX.fillStyle=g;sX.fill();

  // Çizgi
  sX.beginPath();sX.strokeStyle='#00d4ff';sX.lineWidth=1.5;
  m.forEach((v,i)=>{
    const x=W*i/BINS,n=Math.max(0,Math.min(1,(v-lo)/(hi-lo)));
    i?sX.lineTo(x,H-n*H):sX.moveTo(x,H-n*H);
  });
  sX.stroke();

  // Tepe noktası
  const pi=m.reduce((mi,v,i)=>v>m[mi]?i:mi,0);
  const px=W*pi/BINS,pn=Math.max(0,Math.min(1,(m[pi]-lo)/(hi-lo))),py=H-pn*H;
  sX.beginPath();sX.arc(px,py,5,0,Math.PI*2);sX.fillStyle='#ff1744';sX.fill();
  sX.fillStyle='#ff6090';sX.font='9px Courier New';sX.textAlign='center';
  const fl=f[pi];
  sX.fillText(fl>=1000?(fl/1000).toFixed(2)+'kHz':fl.toFixed(0)+'Hz',px,py-9);
}

// --- Frekans ekseni ---
function drawAx(f){
  const W=ax.width;
  aX.fillStyle='#040810';aX.fillRect(0,0,W,18);
  aX.fillStyle='#1a4060';aX.font='9px Courier New';aX.textAlign='center';
  for(let i=0;i<BINS;i+=16){
    const x=W*i/BINS,fl=f[i]||(i*FS/2/BINS);
    aX.fillText(fl>=1000?(fl/1000).toFixed(1)+'k':fl.toFixed(0),x,13);
  }
}

// --- Tooltip ---
sc.addEventListener('mousemove',e=>{
  const r=sc.getBoundingClientRect();
  const b=Math.floor((e.clientX-r.left)/r.width*BINS);
  if(b>=0&&b<BINS&&CF.length){
    const t=document.getElementById('tip');
    t.style.cssText=`display:block;left:${e.clientX+12}px;top:${e.clientY-10}px`;
    const fl=CF[b];
    t.innerHTML=`&#128225; ${fl>=1000?(fl/1000).toFixed(2)+'kHz':fl.toFixed(0)+'Hz'}<br>Güç: ${CM[b].toFixed(1)}`;
  }
});
sc.addEventListener('mouseleave',()=>document.getElementById('tip').style.display='none');

// --- Slider etiket güncelle ---
['lo','hi'].forEach(id=>{
  const el=document.getElementById(id);
  el.addEventListener('input',()=>document.getElementById(id+'V').textContent=el.value);
});

// --- Veri çek ---
async function fetchData(){
  try{
    const r=await fetch('/data',{cache:'no-store'});
    if(!r.ok) throw 0;
    const d=await r.json();
    CM=d.magnitudes; CF=d.frequencies;

    // Peak hold güncelle
    if(hold) CM.forEach((v,i)=>{ if(v>pk[i]) pk[i]=v; });

    // Tepe
    const pi=CM.reduce((mi,v,i)=>v>CM[mi]?i:mi,0);
    const pf=CF[pi],pm=CM[pi];
    const fStr=pf>=1000?(pf/1000).toFixed(3)+' kHz':pf.toFixed(0)+' Hz';
    document.getElementById('pkf').textContent=fStr;
    document.getElementById('pkm').textContent=pm.toFixed(1);

    // SNR
    const srt=[...CM].sort((a,b)=>a-b);
    const ns=srt.slice(0,40).reduce((a,v)=>a+v,0)/40;
    document.getElementById('snr').innerHTML=(ns>0?(20*Math.log10(pm/ns)).toFixed(1):0)+'<span class="un">dB</span>';

    // S-Meter
    const pct=Math.min(100,(pm/+document.getElementById('hi').value)*100);
    document.getElementById('smf').style.width=pct+'%';

    // Bilgiler
    document.getElementById('upt').innerHTML=(d.timestamp/1000).toFixed(0)+'<span class="un">sn</span>';
    frame++;document.getElementById('frm').innerHTML=frame+'<span class="un">#</span>';

    document.getElementById('led').className='dot on';
    document.getElementById('sts').textContent='Bağlı';

    drawSpec(CM,CF); wfRow(CM); drawAx(CF);

  }catch(e){
    document.getElementById('led').className='dot';
    document.getElementById('sts').textContent='Bağlantı Yok';
  }
}

// --- Butonlar ---
document.getElementById('holdBtn').addEventListener('click',function(){
  hold=!hold;this.classList.toggle('on',hold);
  this.textContent=hold?'⏹ Peak Hold':'▶ Peak Hold';
  if(!hold) pk.fill(0);
});
document.getElementById('clrBtn').addEventListener('click',()=>{ pk.fill(0);frame=0;resize(); });

// --- Başlat ---
window.addEventListener('resize',resize);
resize();
setInterval(fetchData,500);
fetchData();
</script>
