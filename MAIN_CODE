#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <arduinoFFT.h>

// ---- WiFi ----
const char* SSID = "RadioScope";
const char* PASS = "rfdetect";

// ---- FFT Ayarları ----
#define SAMPLES  256          // Örnekleme sayısı (2'nin kuvveti)
#define FS       100000       // Örnekleme frekansı (Hz) — ESP8266 ADC donanım maksimumu
#define BINS     (SAMPLES/2)  // Çıktı bin sayısı: 128

ArduinoFFT<double> FFT = ArduinoFFT<double>();
double vReal[SAMPLES];
double vImag[SAMPLES];

// ---- Web Sunucu ----
ESP8266WebServer server(80);

// ---- Sonuçlar ----
float mags[BINS];
float freqs[BINS];
unsigned long ts = 0;

// ---- Zamanlama ----
unsigned long lastRead = 0;

// ================================================================
// FFT
// ================================================================
void doFFT() {
  unsigned long period = 1000000UL / FS;

  // A0'dan oku
  for (int i = 0; i < SAMPLES; i++) {
    unsigned long t0 = micros();
    vReal[i] = analogRead(A0);  // 0–1023
    vImag[i] = 0;
    while (micros() - t0 < period);
  }

  // DC bileşeni kaldır (daha temiz spektrum)
  double dc = 0;
  for (int i = 0; i < SAMPLES; i++) dc += vReal[i];
  dc /= SAMPLES;
  for (int i = 0; i < SAMPLES; i++) vReal[i] -= dc;

  // Blackman penceresi (zayıf sinyaller için en iyisi)
  FFT.windowing(vReal, SAMPLES, FFT_WIN_TYP_BLACKMAN, FFT_FORWARD);
  FFT.compute(vReal, vImag, SAMPLES, FFT_FORWARD);
  FFT.complexToMagnitude(vReal, vImag, SAMPLES);

  // Sonuçları kaydet
  for (int i = 0; i < BINS; i++) {
    freqs[i] = (float)i * FS / SAMPLES;
    mags[i]  = (i == 0) ? 0 : (float)vReal[i];  // DC bin = 0
  }

  ts = millis();
}

