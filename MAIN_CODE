// ================================================================
void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("\n[RadioScope] Baslatiyor...");

  WiFi.mode(WIFI_AP);
  WiFi.softAP(SSID, PASS);
  Serial.print("[WiFi] IP: ");
  Serial.println(WiFi.softAPIP());

  server.on("/", [](){
    server.sendHeader("Cache-Control","no-cache");
    server.send_P(200,"text/html; charset=utf-8",PAGE);
  });

  server.on("/data", [](){
    server.sendHeader("Access-Control-Allow-Origin","*");
    server.sendHeader("Cache-Control","no-cache");

    String j="{\"timestamp\":";
    j+=ts;
    j+=",\"frequencies\":[";
    for(int i=0;i<BINS;i++){j+=String(freqs[i],1);if(i<BINS-1)j+=",";}
    j+="],\"magnitudes\":[";
    for(int i=0;i<BINS;i++){j+=String(mags[i],1);if(i<BINS-1)j+=",";}
    j+="]}";

    server.send(200,"application/json",j);
  });

  server.onNotFound([](){
    server.send(404,"text/plain","Not Found");
  });

  server.begin();
  Serial.println("[HTTP] Hazir — http://192.168.4.1");
}

void loop() {
  server.handleClient();
  if(millis()-lastRead >= 500){
    lastRead=millis();
    doFFT();
  }
}

void doFFT(){
  // 100kHz için bekleme döngüsü yok — analogRead() zaten ~10µs sürer
  // Donanım hızında oku (maksimum örnekleme)
  for(int i=0;i<SAMPLES;i++){
    vReal[i]=analogRead(A0);
    vImag[i]=0;
  }

  // DC sil
  double dc=0;
  for(int i=0;i<SAMPLES;i++) dc+=vReal[i];
  dc/=SAMPLES;
  for(int i=0;i<SAMPLES;i++) vReal[i]-=dc;

  // Blackman penceresi + FFT
  FFT.windowing(vReal,SAMPLES,FFT_WIN_TYP_BLACKMAN,FFT_FORWARD);
  FFT.compute(vReal,vImag,SAMPLES,FFT_FORWARD);
  FFT.complexToMagnitude(vReal,vImag,SAMPLES);

  // Kaydet
  for(int i=0;i<BINS;i++){
    freqs[i]=(float)i*FS/SAMPLES;
    mags[i]=(i==0)?0:(float)vReal[i];
  }
  ts=millis();

  // Tepe bilgisi Serial'a yaz
  int pi=0;
  for(int i=1;i<BINS;i++) if(mags[i]>mags[pi]) pi=i;
  Serial.printf("[FFT] Tepe: %.0f Hz | Guc: %.1f\n",freqs[pi],mags[pi]);
}
